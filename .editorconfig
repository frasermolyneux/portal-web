root = true

[*.{cs,vb}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
dotnet_analyzer_diagnostic.category-naming.severity = warning
dotnet_analyzer_diagnostic.category-style.severity = warning
dotnet_analyzer_diagnostic.category-maintainability.severity = warning
dotnet_analyzer_diagnostic.category-formatting.severity = warning
dotnet_analyzer_diagnostic.category-security.severity = warning
dotnet_analyzer_diagnostic.category-performance.severity = warning
dotnet_analyzer_diagnostic.category-reliability.severity = warning
dotnet_analyzer_diagnostic.category-usage.severity = warning

# Lower-noise categories can start at suggestion.
dotnet_analyzer_diagnostic.category-design.severity = suggestion
dotnet_analyzer_diagnostic.category-globalization.severity = suggestion

# C# style baseline.
csharp_using_directive_placement = outside_namespace:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_style_namespace_declarations = file_scoped:warning

# .NET style baseline.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_namespace_match_folder = true:warning

# Existing forum integration paths rely on ambient-culture parsing/formatting; defer broad globalization refactor.
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1311.severity = suggestion
dotnet_diagnostic.CA1051.severity = suggestion
dotnet_diagnostic.CA1001.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion # Logging call-site message formatting is widespread; defer mass refactor during analyzer standards rollout.

# Avoid IDE0005 build coupling to GenerateDocumentationFile during standards rollout.
dotnet_diagnostic.IDE0005.severity = none

dotnet_diagnostic.IDE0011.severity = warning
[**/*Tests.cs]
# Keep descriptive xUnit method names with underscores for readability in test code.
dotnet_diagnostic.CA1707.severity = none

[*.g.cs]
dotnet_analyzer_diagnostic.severity = none

[*.Designer.cs]
dotnet_analyzer_diagnostic.severity = none

[*.generated.cs]
dotnet_analyzer_diagnostic.severity = none

[*.AssemblyInfo.cs]
dotnet_analyzer_diagnostic.severity = none

# BEGIN platform-devex managed .NET analyzer policy
# Managed by platform-devex repository standards. Do not edit this section by hand.
# Provenance: repository-standards-v1 / dotnet-editorconfig-v1
[*.{cs,vb}]
# Profile: curated-low-noise
# Public XML documentation completeness is not an estate-wide correctness requirement.
dotnet_diagnostic.CS1591.severity = none
# Expression-value simplification is optional style; compiler correctness diagnostics remain enabled.
dotnet_diagnostic.IDE0058.severity = none
# Expression-bodied member selection is a formatting preference rather than a correctness control.
dotnet_diagnostic.IDE0022.severity = none
# ConfigureAwait is not required for the estate's application and test workloads.
dotnet_diagnostic.CA2007.severity = none
# Source-generated logging is an optional micro-optimisation for these personal projects.
dotnet_diagnostic.CA1848.severity = none
# Namespace-to-folder alignment is a repository layout preference rather than a correctness control.
dotnet_diagnostic.IDE0130.severity = none
# File-scoped namespace selection is a formatting preference rather than a correctness control.
dotnet_diagnostic.IDE0161.severity = none
# Logging argument evaluation is an optional performance optimisation for these workloads.
dotnet_diagnostic.CA1873.severity = none
# Conditional-expression selection is a readability preference rather than a correctness control.
dotnet_diagnostic.IDE0046.severity = none
# Primary-constructor adoption is a modernisation preference rather than a correctness control.
dotnet_diagnostic.IDE0290.severity = none
# Collection-expression adoption is a modernisation preference rather than a correctness control.
dotnet_diagnostic.IDE0300.severity = none
# Redundant suppression cleanup is low-value churn when the centrally managed policy changes diagnostic severity.
dotnet_diagnostic.IDE0370.severity = none
# Profile: actionable-only
# XML documentation reference precision is deferred from the initial actionable-only baseline.
dotnet_diagnostic.CS0419.severity = none
# XML documentation formatting is deferred from the initial actionable-only baseline.
dotnet_diagnostic.CS1570.severity = none
# XML parameter documentation completeness is deferred from the initial actionable-only baseline.
dotnet_diagnostic.CS1573.severity = none
# Public field design is an API convention rather than an estate-wide correctness requirement.
dotnet_diagnostic.CA1051.severity = none
# Cancellation-token parameter ordering is an API convention rather than a correctness defect.
dotnet_diagnostic.CA1068.severity = none
# Explicit culture selection is deferred unless a concrete globalization defect is identified.
dotnet_diagnostic.CA1304.severity = none
# Explicit format-provider selection is deferred unless a concrete globalization defect is identified.
dotnet_diagnostic.CA1305.severity = none
# String-comparison overload preference is deferred unless a concrete correctness defect is identified.
