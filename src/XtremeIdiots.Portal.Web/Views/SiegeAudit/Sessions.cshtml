@model XtremeIdiots.Portal.Web.Controllers.SiegeAuditViewModel
@{
    ViewData["Title"] = "Siege Sessions";
    var now = DateTime.UtcNow;
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row"><div class="col-12"><div class="container-fluid">
        <div class="ibox">
            <div class="ibox-title"><h5>Siege Sessions</h5></div>
            <div class="ibox-content">
                <partial name="_Filters" model="Model" />
                <p>Active and historical sessions. Refresh the page to update.</p>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead><tr><th>Session</th><th>Server</th><th>Status</th><th>Mode</th><th>Started</th><th>Expires</th><th>Ended</th><th>Started by</th><th>Actions</th></tr></thead>
                        <tbody>
                        @foreach (var session in Model.Sessions)
                        {
                            var server = Model.Servers.FirstOrDefault(s => s.GameServerId == session.GameServerId);
                            <tr>
                                <td><a asp-action="Session" asp-route-serverId="@session.GameServerId" asp-route-sessionId="@session.SessionId">@session.SessionId</a></td>
                                <td>@if (server is not null) { <a asp-controller="ServerAdmin" asp-action="ServerDetail" asp-route-id="@server.GameServerId"><game-type-icon game="@server.GameType"></game-type-icon> @server.Title</a> }</td>
                                <td>@(session.EndedAtUtc.HasValue ? "Ended" : session.ExpiresAtUtc <= now ? "Expired" : "Active")</td>
                                <td>@session.Mode</td><td><time time-ago utc="@session.StartedAtUtc" show-absolute="false"></time></td>
                                <td><time time-ago utc="@session.ExpiresAtUtc" show-absolute="false"></time></td><td>@if (session.EndedAtUtc.HasValue) { <time time-ago utc="@session.EndedAtUtc.Value" show-absolute="false"></time> }</td>
                                <td>@if (session.StartedBy is not null && Model.StartingUsers.TryGetValue(session.StartedBy, out var displayName)) { <a href="https://www.xtremeidiots.com/profile/@session.StartedBy/">@displayName</a> } else { @session.StartedBy }</td><td>@session.ActionCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.Sessions.Count == 0) { <p>No sessions found.</p> }
                <partial name="_Pagination" model="Model" />
            </div>
        </div>
    </div></div></div>
</div>
