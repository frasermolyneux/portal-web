@using XtremeIdiots.Portal.Web.Services
@model List<AgentServerSummary>

@{
    ViewData["Title"] = "Agent Status";
}

<div class="wrapper wrapper-content animated fadeInRight">

    <div class="alert alert-primary" role="alert">
        <i class="fa-solid fa-fw fa-circle-info"></i> Agent health uses an operational heartbeat, independent of players
        and game events. Unknown means no heartbeat is available. An overdue heartbeat requires checking the agent's
        transport and lease logs; a quiet game alone is not a fault.
    </div>

    <div class="row">
        <div class="col-12">

            <div class="container-fluid">
                <div class="ibox">
                    <div class="ibox-title">
                        <h5>Agent Status Overview</h5>
                        <span class="float-end">
                            <span id="agent-status-counts"></span>
                            <span class="badge bg-secondary">@Model.Count Total</span>
                        </span>
                    </div>
                    <div class="ibox-content">
                        @if (!Model.Any())
                        {
                            <div class="alert alert-warning">
                                <i class="fa-solid fa-fw fa-triangle-exclamation"></i> No agent-enabled servers found.
                            </div>
                        }
                        else
                        {
                            <div data-overview-url="@Url.Action("GetOverviewTelemetry")">
                                <p class="text-muted" role="status">Loading agent telemetry…</p>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover w-100">
                                    <thead>
                                        <tr>
                                            <th>Server</th>
                                            <th>Game</th>
                                            <th>Status</th>
                                            <th>Last Heartbeat</th>
                                            <th>Last Event</th>
                                            <th>Events (1h)</th>
                                            <th>Players</th>
                                            <th>Map</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var server in Model)
                                        {
                                            <tr data-agent-server="@server.ServerId">
                                                <td>
                                                    <a asp-controller="ServerAdmin" asp-action="ServerDetail" asp-route-id="@server.ServerId">
                                                        <server-name title="@(server.ServerTitle ?? server.ServerId.ToString())"></server-name>
                                                    </a>
                                                </td>
                                                <td>@server.GameType</td>
                                                <td data-agent-field="status"><span class="badge bg-secondary">Loading</span></td>
                                                <td data-agent-field="heartbeat">—</td>
                                                <td data-agent-field="lastEvent">—</td>
                                                <td data-agent-field="events">—</td>
                                                <td>@server.PlayerCount</td>
                                                <td>@(server.CurrentMap ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @section Scripts {
                                <script src="~/js/overview-panels.js" asp-append-version="true"></script>
                            }
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
