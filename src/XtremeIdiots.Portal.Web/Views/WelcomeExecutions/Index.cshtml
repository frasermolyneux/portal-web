@using System.Text
@using XtremeIdiots.Portal.Repository.Abstractions.Models.V1.RulesEngine
@model XtremeIdiots.Portal.Web.Controllers.WelcomeExecutionsViewModel
@{
    ViewData["Title"] = "Welcome Execution Diagnostics";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row"><div class="col-12"><div class="container-fluid">
        <div class="ibox">
            <div class="ibox-title"><h5>Welcome Execution Diagnostics - @Model.Server.Title</h5></div>
            <div class="ibox-content">
                <form method="get" class="list-filters mb-3">
                    <input type="hidden" name="id" value="@Model.Server.GameServerId" />
                    <div class="filter-group">
                        <label class="form-label" for="fromUtc">Created from (UTC, inclusive)</label>
                        <input class="form-control" type="datetime-local" id="fromUtc" name="fromUtc" value="@Model.FromUtc.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="filter-group">
                        <label class="form-label" for="toUtc">Created before (UTC, exclusive)</label>
                        <input class="form-control" type="datetime-local" id="toUtc" name="toUtc" value="@Model.ToUtc.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="filter-group"><button class="btn btn-primary" type="submit">Filter</button></div>
                </form>
                <p>Newest executions first, including waiting and no-action executions. Pending, claimed and dispatched fragments do not confirm receipt. Dry-run outcomes are simulated.</p>
                <p>Diagnostics are recorded observations. An empty history does not prove that no rule matched or that protection suppressed a welcome.</p>
                @if (Model.Executions.Length == 0)
                {
                    <p>No welcome executions found in this time range.</p>
                }
                @foreach (var execution in Model.Executions)
                {
                    <section class="border rounded p-3 mb-3" data-execution-id="@execution.ExecutionId">
                        <h6>@execution.State - @(execution.Trigger.Username ?? "Unknown player")</h6>
                        <dl class="detail-fields row">
                            <div class="detail-field col-sm-6"><dt class="detail-label">Execution</dt><dd class="detail-value">@execution.ExecutionId</dd></div>
                            <div class="detail-field col-sm-6"><dt class="detail-label">Connection</dt><dd class="detail-value">@execution.ConnectionId</dd></div>
                            <div class="detail-field col-sm-6"><dt class="detail-label">Created</dt><dd class="detail-value"><time time-ago utc="@execution.CreatedAtUtc.UtcDateTime"></time></dd></div>
                            <div class="detail-field col-sm-6"><dt class="detail-label">Updated</dt><dd class="detail-value"><time time-ago utc="@execution.UpdatedAtUtc.UtcDateTime"></time></dd></div>
                            @if (execution.Coordination is { } coordination)
                            {
                                <div class="detail-field col-sm-6"><dt class="detail-label">Due</dt><dd class="detail-value"><time time-ago utc="@coordination.DueAtUtc.UtcDateTime"></time></dd></div>
                                <div class="detail-field col-sm-6"><dt class="detail-label">Expires</dt><dd class="detail-value"><time time-ago utc="@coordination.ExpiresAtUtc.UtcDateTime"></time></dd></div>
                                @if (execution.State == RuleFeatureExecutionState.Waiting && !string.IsNullOrEmpty(coordination.WaitingReason))
                                {
                                    <div class="detail-field col-12"><dt class="detail-label">Current waiting reason</dt><dd class="detail-value">@coordination.WaitingReason</dd></div>
                                }
                            }
                        </dl>
                        <h6>Recorded diagnostics</h6>
                        @if (execution.Diagnostics.Length == 0)
                        {
                            <p>No typed diagnostics recorded; older executions may not provide these details.</p>
                        }
                        @foreach (var diagnostic in execution.Diagnostics)
                        {
                            <div class="@(diagnostic.Code == RuleExecutionDiagnosticCode.DiagnosticsOmitted ? "alert alert-warning" : "border-bottom py-2")">
                                <strong>@diagnostic.Code</strong>
                                @if (diagnostic.Code == RuleExecutionDiagnosticCode.DiagnosticsOmitted)
                                {
                                    <span> - @diagnostic.OmittedCount additional diagnostics omitted.</span>
                                }
                                <span>@diagnostic.Detail</span>
                                <div class="small text-muted">
                                    <time time-ago utc="@diagnostic.ObservedAtUtc.UtcDateTime"></time>
                                    @if (diagnostic.RuleId is not null) { <span> Rule: @diagnostic.RuleId</span> }
                                    @if (diagnostic.ActionId is not null) { <span> Action: @diagnostic.ActionId</span> }
                                    @if (diagnostic.TokenKey is not null) { <span> Token: @diagnostic.TokenKey</span> }
                                    @if (diagnostic.Source is not null) { <span> Source: @diagnostic.Source</span> }
                                </div>
                            </div>
                        }
                        @foreach (var prepared in execution.PreparedActions)
                        {
                            <details class="mt-3">
                                <summary>Prepared action @prepared.ActionId: @prepared.Outcome - @prepared.CompletedFragmentCount / @prepared.TotalFragmentCount fragments completed</summary>
                                <p>@prepared.Detail</p>
                                @if (prepared.RuleCoordination is { } timing)
                                {
                                    <p>Frozen rule window: @timing.DueAtUtc.ToString("u") to @timing.ExpiresAtUtc.ToString("u").</p>
                                }
                                <p>Frozen commands are evidence of preparation, not confirmation of delivery.</p>
                                @foreach (var command in prepared.Commands)
                                {
                                    <div class="border-bottom py-2">
                                        <span>@command.Mode / @command.Effect.Type</span>
                                        @if (command.DeliveryIdentity is { } delivery)
                                        {
                                            <span> - Item @(delivery.MessageIndex + 1), fragment @(delivery.FragmentIndex + 1)</span>
                                            @if (delivery.RecipientConnectionId.HasValue) { <span> - Recipient connection: @delivery.RecipientConnectionId</span> }
                                        }
                                        @if (command.Effect.Message is { } message)
                                        {
                                            <pre class="text-wrap mb-1">@message</pre>
                                            <span class="small text-muted">@Encoding.UTF8.GetByteCount(message) UTF-8 bytes (text only)</span>
                                        }
                                    </div>
                                }
                            </details>
                        }
                        @if (execution.Actions.Length > 0)
                        {
                            <h6 class="mt-3">Action outcomes</h6>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead><tr><th>Rule / action</th><th>Mode</th><th>Outcome</th><th>Detail</th></tr></thead>
                                    <tbody>
                                        @foreach (var action in execution.Actions)
                                        {
                                            <tr><td>@action.RuleId / @action.ActionId</td><td>@action.Mode</td><td>@action.Outcome</td><td>@action.Detail</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
                <nav aria-label="Execution pages">
                    @if (Model.Page > 0)
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-id="@Model.Server.GameServerId" asp-route-fromUtc="@Model.FromUtc.ToString("O")" asp-route-toUtc="@Model.ToUtc.ToString("O")" asp-route-page="@(Model.Page - 1)">Previous</a>
                    }
                    @if (Model.HasNext)
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-id="@Model.Server.GameServerId" asp-route-fromUtc="@Model.FromUtc.ToString("O")" asp-route-toUtc="@Model.ToUtc.ToString("O")" asp-route-page="@(Model.Page + 1)">Next</a>
                    }
                </nav>
            </div>
            <div class="ibox-footer">
                <a class="btn btn-outline-secondary" asp-controller="GameServers" asp-action="Edit" asp-route-id="@Model.Server.GameServerId">Back to Server Settings</a>
            </div>
        </div>
    </div></div></div>
</div>
