@using XtremeIdiots.Portal.Web.Services
@using XtremeIdiots.Portal.Web.ViewModels
@model DashboardViewModel
@if (Model.AgentTelemetryUnavailable)
{
    <div class="alert alert-warning" role="status" data-overview-unavailable>Agent telemetry is currently unavailable.</div>
}
else
{
    @if (Model.AgentTelemetryStale)
    {
        <p class="text-warning" role="status">Showing cached agent telemetry; the latest refresh failed.</p>
    }
    <p>
        <span class="badge bg-success">@Model.AgentStatuses.Count(s => s.ActivityStatus == AgentActivityStatus.Active) Active</span>
        <span class="badge bg-info">@Model.AgentStatuses.Count(s => s.ActivityStatus == AgentActivityStatus.Idle) Idle</span>
        <span class="badge bg-danger">@Model.AgentStatuses.Count(s => s.ActivityStatus == AgentActivityStatus.Offline) Offline</span>
    </p>
}
@if (Model.AgentStatuses.Count == 0)
{
    <p class="text-muted">No agent-enabled servers found.</p>
}
else
{
    <div class="table-responsive"><table class="table table-striped table-hover table-sm w-100">
        <thead><tr><th>Server</th><th>Status</th><th>Players</th><th>Map</th><th>Last Event</th></tr></thead>
        <tbody>
        @foreach (var server in Model.AgentStatuses)
        {
            var badge = server.ActivityStatus switch { AgentActivityStatus.Active => "bg-success", AgentActivityStatus.Idle => "bg-info", _ => "bg-danger" };
            <tr>
                <td><a asp-controller="ServerAdmin" asp-action="ServerDetail" asp-route-id="@server.ServerId">
                    @if (Enum.TryParse<GameType>(server.GameType, out var game))
                    {
                        <game-type-icon game="@game"></game-type-icon>
                    }
                    <server-name title="@server.ServerTitle"></server-name>
                </a></td>
                <td><span class="badge @(Model.AgentTelemetryUnavailable ? "bg-secondary" : badge)">@(Model.AgentTelemetryUnavailable ? "Unavailable" : server.ActivityStatus.ToString())</span></td>
                <td>@(Model.AgentTelemetryUnavailable ? "—" : server.PlayerCount.ToString())</td>
                <td><small>@server.CurrentMap</small></td>
                <td>
                    @if (!Model.AgentTelemetryUnavailable && server.LastEventReceived.HasValue)
                    {
                        <time time-ago utc="@server.LastEventReceived.Value" show-absolute="false"></time>
                    }
                    else { <span class="text-muted">—</span> }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
