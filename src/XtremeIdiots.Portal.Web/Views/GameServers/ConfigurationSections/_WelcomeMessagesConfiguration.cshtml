@model XtremeIdiots.Portal.Web.ViewModels.GameServerEditViewModel
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.RulesEngine
@using XtremeIdiots.Portal.Web.ViewModels

@{
    var hasEffectiveTimings = WelcomeRulesSettingsMapper.TryGetEffectiveTimings(Model.GlobalWelcomeRules, Model.WelcomeRules, out var effectiveTimings);
}
@if (!hasEffectiveTimings)
{
    <p class="alert alert-warning">Effective timing is unavailable until global and server rule settings are valid.</p>
}
@await Html.PartialAsync("_ServerFeatureRules", new ServerFeatureRulesViewModel
{
    Prefix = "WelcomeRules",
    Title = "Welcome Messages",
    FeatureId = RulesEngineCatalogueV1.WelcomeMessagesFeature,
    GameServerId = Model.GameServer.GameServerId,
    EffectiveTimings = hasEffectiveTimings ? effectiveTimings : null,
    Enabled = Model.WelcomeRules.Enabled,
    GlobalEnabled = Model.GlobalWelcomeRules.Enabled,
    InheritGlobalRules = Model.WelcomeRules.InheritGlobalRules,
    ConnectionDelaySeconds = Model.WelcomeRules.ConnectionDelaySeconds,
    FreshnessSeconds = Model.WelcomeRules.FreshnessSeconds,
    GlobalConnectionDelaySeconds = Model.GlobalWelcomeRules.ConnectionDelaySeconds,
    GlobalFreshnessSeconds = Model.GlobalWelcomeRules.FreshnessSeconds,
    LocalRulesJson = Model.WelcomeRules.LocalRulesJson,
    RuleOverridesJson = Model.WelcomeRules.RuleOverridesJson,
    GlobalRulesJson = Model.GlobalWelcomeRules.RulesJson,
    Tags = Model.AvailableRequiredTags,
    Compatibility = Model.WelcomeRuleCompatibility,
    HasFreshCapabilitySnapshot = Model.HasFreshRuleCapabilitySnapshot
})
