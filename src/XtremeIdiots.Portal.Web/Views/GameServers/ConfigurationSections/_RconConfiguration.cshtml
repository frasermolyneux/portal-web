@using XtremeIdiots.Portal.Web.ViewModels
@model GameServerEditViewModel

<div class="ibox">
    <div class="ibox-title">
        <h5>RCON Configuration</h5>
    </div>
    <div class="ibox-content">
        <div class="mb-3">
            <label asp-for="RconConfigPassword" class="form-label"></label>
            <div class="input-group">
                <input name="RconConfigPassword" class="form-control" type="password" id="rconPasswordInput"
                       value="@Model.RconConfigPassword" data-testid="rcon-password-input" />
                <button class="btn btn-outline-secondary" type="button" data-password-toggle="rconPasswordInput"
                        data-testid="rcon-password-toggle" aria-label="Show or hide RCON password">
                    <i class="fa-solid fa-fw fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="RconConfigPassword" class="text-danger"></span>
            <small class="form-text text-muted">The RCON password used for remote server administration.</small>
        </div>
    </div>
</div>
