@model XtremeIdiots.Portal.Web.ViewModels.GameServerEditViewModel
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.RulesEngine
@using XtremeIdiots.Portal.Web.ViewModels

@await Html.PartialAsync("_ServerFeatureRules", new ServerFeatureRulesViewModel
{
    Prefix = "VpnProtection",
    Title = "VPN Protection",
    FeatureId = RulesEngineCatalogueV1.VpnProtectionFeature,
    Enabled = Model.VpnProtection.Enabled,
    GlobalEnabled = Model.GlobalVpnProtection.Enabled,
    InheritGlobalRules = Model.VpnProtection.InheritGlobalRules,
    LocalRulesJson = Model.VpnProtection.LocalRulesJson,
    RuleOverridesJson = Model.VpnProtection.RuleOverridesJson,
    GlobalRulesJson = Model.GlobalVpnProtection.RulesJson,
    Tags = Model.AvailableRequiredTags,
    Compatibility = Model.VpnRuleCompatibility,
    HasFreshCapabilitySnapshot = Model.HasFreshRuleCapabilitySnapshot
})
