@{
    ViewData["Title"] = "Maps Index";
    var dataUrl = "/Maps/GetMapListAjax";
    if (ViewData["GameType"] != null)
    {
        ViewData["Title"] = ViewData["GameType"] + " Maps Index";
        dataUrl = "/Maps/GetMapListAjax/" + ViewData["GameType"];
    }
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-12">
            <div class="list-filters mb-2" id="mapsFilters">
                <div class="filter-group">
                    <label for="filterGameType" class="form-label">Map Family</label>
                    <select id="filterGameType" class="form-select">
                        <option value="">All Games</option>
                        @foreach (var gt in
                                                Enum.GetValues<XtremeIdiots.Portal.Repository.Abstractions.Constants.V1.GameType>()
                                                .Where(game => game != XtremeIdiots.Portal.Repository.Abstractions.Constants.V1.GameType.CallOfDuty4x))
                        {
                            var isSelected = ViewData["GameType"] != null && ViewData["GameType"]!.ToString() ==
                            gt.ToString();
                            <option value="@gt" selected="@(isSelected ? "selected" : null)">@(gt == XtremeIdiots.Portal.Repository.Abstractions.Constants.V1.GameType.CallOfDuty4 ? "COD4 / COD4x" : gt.ToString())</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label class="form-label" for="resetFilters">Reset</label>
                    <button type="button" id="resetFilters" class="btn btn-outline-secondary btn-sm">Clear
                        Filters</button>
                </div>
            </div>
            <div class="ibox maps-table-wrapper">
                <div class="ibox-title">
                    <h5>@ViewData["Title"]</h5>
                    <div class="ibox-tools">
                        <a asp-controller="MapDownloads" asp-action="Index" class="btn btn-primary btn-sm">Map and mod downloads</a>
                    </div>
                </div>
                <div class="ibox-content">
                    <p id="maps-help" class="text-muted">COD4 and COD4x share one map catalogue and combined map ratings.</p>
                    <div class="table-responsive">
                        <table id="dataTable" class="table table-striped table-hover w-100" data-source="@dataUrl"
                            aria-describedby="maps-help">
                            <thead>
                                <tr>
                                    <th scope="col">Map Family</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Map Files</th>
                                    <th scope="col">Popularity</th>
                                    <th scope="col">Image</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="__af" method="post" style="display:none">@Html.AntiForgeryToken()</form>
    <script src="~/js/maps-index.js" asp-append-version="true"></script>
}
