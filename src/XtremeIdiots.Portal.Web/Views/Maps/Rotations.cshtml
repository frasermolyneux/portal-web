@using XtremeIdiots.Portal.Repository.Abstractions.Constants.V1
@using XtremeIdiots.Portal.Web.Extensions
@model XtremeIdiots.Portal.Repository.Abstractions.Models.V1.MapRotations.PublicServerRotationsDto
@{
    ViewData["Title"] = "Map Rotations";
}
<div class="wrapper wrapper-content animated fadeInRight" id="publicRotations">
    <h2>Map Rotations</h2>
    <p>Explore the maps on each server and see what other players think. Download a map pack to get ready to play.</p>
    <div class="ibox"><div class="ibox-content">
        <div class="row g-3">
            <div class="col-md-5">
                <label for="rotationGame" class="form-label">Game</label>
                <select id="rotationGame" class="form-select">
                    <option value="">All games</option>
                    @foreach (var game in Model.Servers.Select(s => s.GameType == GameType.CallOfDuty4x ? GameType.CallOfDuty4 : s.GameType).Distinct().Order())
                    {
                        <option value="@game">@(game == GameType.CallOfDuty4 ? "COD4 / COD4x" : game.ToDisplayName())</option>
                    }
                </select>
            </div>
            <div class="col-md-7">
                <label for="rotationServer" class="form-label">Server</label>
                <select id="rotationServer" class="form-select">
                    <option value="">All servers</option>
                    @foreach (var server in Model.Servers)
                    {
                        <option value="@server.GameServerId" data-game="@(server.GameType == GameType.CallOfDuty4x ? GameType.CallOfDuty4 : server.GameType)">@server.Title</option>
                    }
                </select>
            </div>
        </div>
    </div></div>
    <p class="small text-muted">Map packs include extra maps you need to download, not maps already included with the game or server mods. Sign in to prepare a pack. COD2 map packs are not available yet.</p>
    <p id="rotationEmpty" role="status" hidden="@(Model.Servers.Count > 0)">No maps to show for this selection.</p>
    @foreach (var server in Model.Servers)
    {
        <section class="ibox public-map-rotation" aria-label="@server.Title" data-server="@server.GameServerId"
                 data-game="@(server.GameType == GameType.CallOfDuty4x ? GameType.CallOfDuty4 : server.GameType)">
            <div class="ibox-title">
                <h5><game-type-icon game="@server.GameType" size="24" />
                    <a asp-controller="Servers" asp-action="Details" asp-route-id="@server.GameServerId">@server.Title</a></h5>
                <div class="ibox-tools">
                    @if (server.GameType is GameType.CallOfDuty4 or GameType.CallOfDuty4x or GameType.CallOfDuty5)
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="MapDownloads" asp-action="Index"
                           asp-route-rotation="@server.GameServerId">Download map pack</a>
                    }
                </div>
            </div>
            <div class="ibox-content">
                <p class="small text-muted">@(server.IsObservedHistory ? "Recently played on this server (last 2 days)" : "This server's map rotation")</p>
                <partial name="_PublicMapCards" model="server.Maps" />
            </div>
        </section>
    }
</div>
@section Scripts {
    <script src="~/js/map-rotations.js" asp-append-version="true"></script>
}
