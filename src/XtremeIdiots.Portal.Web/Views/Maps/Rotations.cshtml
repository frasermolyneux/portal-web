@using XtremeIdiots.Portal.Repository.Abstractions.Constants.V1
@using XtremeIdiots.Portal.Web.Extensions
@model XtremeIdiots.Portal.Repository.Abstractions.Models.V1.MapRotations.PublicServerRotationsDto
@{
    ViewData["Title"] = "Map Rotations";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <h2>Map Rotations</h2>
    <p class="text-muted">Current normal rotations on our public servers, with all-time map ratings. When no applied normal rotation is known, recent history shows distinct maps observed over the last 48 hours, newest first; it is not a guaranteed rotation.</p>
    <p>ZIP downloads contain available custom maps only, not built-in maps or server mods. Sign in to prepare a ZIP. COD2 rotation downloads are not supported.</p>
    @if (Model.Servers.Count == 0)
    {
        <p role="status">No public servers are available.</p>
    }
    @foreach (var server in Model.Servers)
    {
        <section class="ibox public-map-rotation" aria-label="@server.Title">
            <div class="ibox-title">
                <h5><a asp-controller="Servers" asp-action="Details" asp-route-id="@server.GameServerId">@server.Title</a></h5>
                <div class="ibox-tools">
                    @if (server.Maps.Count > 0 && server.GameType is GameType.CallOfDuty4 or GameType.CallOfDuty4x or GameType.CallOfDuty5)
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="MapDownloads" asp-action="Index"
                           asp-route-rotation="@server.GameServerId">Download @(server.IsObservedHistory ? "recent maps" : "rotation") ZIP</a>
                    }
                </div>
            </div>
            <div class="ibox-content">
                <p class="small text-muted">@server.GameType.ToDisplayName() &middot;
                    @(server.IsObservedHistory ? "Recent history (48 hours)" : $"Assigned rotation: {server.RotationTitle}")</p>
                @if (server.Maps.Count == 0)
                {
                    <p class="text-muted">No maps observed in the last 48 hours.</p>
                }
                else
                {
                    <div class="public-map-strip" tabindex="0" role="list" aria-label="Maps on @server.Title">
                        @foreach (var map in server.Maps)
                        {
                            <article class="public-map-card" role="listitem">
                                <img src="@(string.IsNullOrWhiteSpace(map.MapImageUri) ? "/images/noimage.jpg" : map.MapImageUri)"
                                     alt="@map.MapName" loading="lazy" width="240" height="180" />
                                <div class="p-2">
                                    <h6>@map.MapName</h6>
                                    <p class="small mb-1">@map.Likes likes &middot; @map.Dislikes dislikes &middot; @map.Votes votes</p>
                                    <progress value="@map.Likes" max="@(Math.Max(1, map.Votes))" aria-label="Approval for @map.MapName"></progress>
                                    <p class="small mb-0">
                                        @(map.Votes == 0 ? "Not yet rated" : $"{map.Approval:0.#}% approval")
                                        @if (map.Votes is > 0 and < 5) { <span class="badge bg-secondary">Low vote count</span> }
                                    </p>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>
