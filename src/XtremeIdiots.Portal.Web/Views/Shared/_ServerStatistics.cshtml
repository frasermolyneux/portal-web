@using System.Text.Json
@using XtremeIdiots.Portal.Web.Services
@inject IConfiguration Configuration
@model OptionalOverviewData<ServerStatisticsOverview>
@{
    var timeline = ViewData["ChartKind"] as string == "timeline";
}
<div class="ibox">
    <div class="ibox-title"><h5>@(timeline ? "Map Timeline" : "Player Count") <small class="text-muted">(48h)</small></h5></div>
    <div class="ibox-content">
        @if (Model.State == OptionalDataState.Unavailable)
        {
            <div class="alert alert-warning mb-0" role="status" data-overview-unavailable>Server statistics are currently unavailable.</div>
        }
        else if (Model.Data is not null)
        {
            @if (Model.State == OptionalDataState.Stale)
            {
                <p class="text-warning" role="status">Showing cached statistics from @Model.ObservedAt?.ToString("u").</p>
            }
            @if (Model.Data.PlayerCounts.Count == 0)
            {
                <p class="text-muted mb-0">No server statistics recorded in the last 48 hours.</p>
            }
            else if (Configuration.GetValue("ExternalAssets:Enabled", true))
            {
                <div id="@ViewData["ChartId"]" data-overview-chart="@(timeline ? "timeline" : "players")"
                     style="height: @(timeline ? Model.Data.MapTimeline.Select(p => p.MapName).Distinct().Count() * 41 + 50 : 300)px; width: 100%;">
                    <div hidden data-chart-data>@JsonSerializer.Serialize(Model.Data, new JsonSerializerOptions(JsonSerializerDefaults.Web))</div>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Charts are disabled.</p>
            }
        }
    </div>
</div>
