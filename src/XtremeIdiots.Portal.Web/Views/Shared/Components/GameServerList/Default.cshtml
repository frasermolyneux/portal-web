@using XtremeIdiots.Portal.Web.Services.Settings
@using XtremeIdiots.Portal.Web.Services
@using XtremeIdiots.Portal.Repository.Abstractions.Models.V1.GameServers
@model List<GameServerDto>

@{
    Layout = null;
    var serverConfigs = ViewBag.ServerConfigs as Dictionary<Guid, GameServerReadSettings> ?? new Dictionary<Guid, GameServerReadSettings>();
}

@functions {
    static string GetCfg(Dictionary<Guid, GameServerReadSettings> configs, Guid id, string ns, string prop)
    {
        return GameServerConfigHelper.GetConfigValue(configs, id, ns, prop);
    }
}

<!DOCTYPE html>

<table style="margin: auto">
    <tbody>
        @foreach (var item in Model)
        {
            var htmlBanner = GetCfg(serverConfigs, item.GameServerId, "serverlist", "htmlBanner");
            <tr>
                <td style="padding: 2px;">
                    <div style="text-align: center;">
                        @Html.Raw(htmlBanner)
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>