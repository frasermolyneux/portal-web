@model XtremeIdiots.Portal.Web.ViewModels.RuleConditionViewModel
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.Shared
@using XtremeIdiots.Portal.Web.ViewModels

@if (Model.GroupOperator.HasValue)
{
    <span>(</span>
    @for (var index = 0; index < Model.Conditions.Count; index++)
    {
        if (index > 0)
        {
            <span> @(Model.GroupOperator == RuleConditionGroupOperator.And ? "AND" : "OR") </span>
        }
        @await Html.PartialAsync("_RuleConditionSummary", Model.Conditions[index])
    }
    <span>)</span>
}
else if (Model.Signal.HasValue && Model.Operator.HasValue)
{
    <span>@VpnProtectionRuleEditorOptions.GetSignalLabel(Model.Signal.Value) @VpnProtectionRuleEditorOptions.GetOperatorLabel(Model.Operator.Value).ToLowerInvariant() <strong>@Model.ExpectedValue</strong></span>
}
else
{
    <span>Invalid condition</span>
}
