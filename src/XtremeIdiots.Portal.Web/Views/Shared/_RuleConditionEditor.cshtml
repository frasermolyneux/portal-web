@model XtremeIdiots.Portal.Web.ViewModels.RuleConditionViewModel
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.SiegeMode
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.Shared
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.VpnProtection
@using XtremeIdiots.Portal.Web.ViewModels
@using Microsoft.AspNetCore.Mvc.ViewFeatures

@{
    var prefix = (string)ViewData["ConditionPrefix"]!;
    var supportsPlayerConditions = (bool?)ViewData["SupportsPlayerConditions"] ?? true;
    var conditionKind = Model.GroupOperator.HasValue ? "group" : Model.PlayerSignal.HasValue ? "player" : Model.Signal.HasValue ? "vpn" : "group";
}

<div class="border rounded p-3 mb-2" data-siege-condition-node data-condition-prefix="@prefix" data-condition-kind="@conditionKind"
     data-vpn-typed-values="@(!supportsPlayerConditions ? "true" : "false")">
    <div class="row align-items-end">
        <div class="col-md-3">
            <div class="mb-3">
                <label class="form-label" data-condition-label="Kind" for="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Kind">Condition type</label>
                <select class="form-select" data-condition-kind-selector id="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Kind">
                    <option value="group" selected="@(conditionKind == "group" ? "selected" : null)">AND/OR group</option>
                    @if (supportsPlayerConditions)
                    {
                        <option value="player" selected="@(conditionKind == "player" ? "selected" : null)">Player/history/tag</option>
                    }
                    <option value="vpn" selected="@(conditionKind == "vpn" ? "selected" : null)">VPN Protection signal</option>
                </select>
            </div>
        </div>
        <div class="col-md-9 text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-action="add-siege-group">
                <i class="fa-solid fa-fw fa-folder-plus" aria-hidden="true"></i> Add Group
            </button>
            @if (supportsPlayerConditions)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-action="add-siege-player-condition">
                    <i class="fa-solid fa-fw fa-user-plus" aria-hidden="true"></i> Add Player Condition
                </button>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-action="add-siege-vpn-condition">
                <i class="fa-solid fa-fw fa-shield" aria-hidden="true"></i> Add VPN Condition
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm mb-3" data-action="remove-siege-condition">
                <i class="fa-solid fa-fw fa-trash" aria-hidden="true"></i> Remove
            </button>
        </div>
    </div>

    <div data-condition-group>
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label" data-condition-label="GroupOperator" for="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_GroupOperator">Match conditions</label>
                    <select class="form-select" data-condition-field="GroupOperator" name="@(prefix).GroupOperator" required
                            id="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_GroupOperator">
                        <option value="">Select a group operator</option>
                        @foreach (var op in Enum.GetValues<RuleConditionGroupOperator>().Where(static value => value != RuleConditionGroupOperator.Unknown))
                        {
                            <option value="@op" selected="@(Model.GroupOperator == op ? "selected" : null)">@(op == RuleConditionGroupOperator.And ? "All conditions (AND)" : "Any condition (OR)")</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="ms-3 ps-3 border-start" data-siege-children>
            @for (var childIndex = 0; childIndex < Model.Conditions.Count; childIndex++)
            {
                var childViewData = new ViewDataDictionary(ViewData)
                {
                    ["ConditionPrefix"] = $"{prefix}.Conditions[{childIndex}]"
                };
                @await Html.PartialAsync("_RuleConditionEditor", Model.Conditions[childIndex], childViewData)
            }
        </div>
    </div>

    <div data-condition-leaf>
        <div class="row">
            <div class="col-md-4" data-player-signal-container>
                <div class="mb-3">
                    <label class="form-label" data-condition-label="PlayerSignal" for="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_PlayerSignal">Player/history/tag signal</label>
                    <select class="form-select" data-condition-field="PlayerSignal" name="@(prefix).PlayerSignal" required
                            id="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_PlayerSignal">
                        <option value="">Select a player signal</option>
                        @foreach (var signal in Enum.GetValues<SiegePlayerSignal>().Where(static value => value != SiegePlayerSignal.Unknown))
                        {
                            <option value="@signal" selected="@(Model.PlayerSignal == signal ? "selected" : null)">
                                @(signal switch
                                {
                                    SiegePlayerSignal.NewGuid => "New game GUID (player history)",
                                    SiegePlayerSignal.NewIp => "New IP address (player history)",
                                    SiegePlayerSignal.PlayerTag => "Player has tag",
                                    _ => signal.ToString()
                                })
                            </option>
                        }
                    </select>
                    <small class="form-text text-muted" data-player-signal-hint>
                        New GUID and new IP refer to the player's history. Player Tag compares against a tag name.
                    </small>
                </div>
            </div>
            <div class="col-md-4" data-vpn-signal-container>
                <div class="mb-3">
                    <label class="form-label" data-condition-label="Signal" for="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Signal">VPN Protection signal</label>
                    <select class="form-select" data-condition-field="Signal" data-role="vpn-signal" name="@(prefix).Signal" required
                            id="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Signal">
                        <option value="">Select a VPN signal</option>
                        @foreach (var signal in Enum.GetValues<VpnProtectionSignal>().Where(static value => value != VpnProtectionSignal.Unknown))
                        {
                            <option value="@signal"
                                    data-value-kind="@VpnProtectionRuleEditorOptions.GetValueKind(signal)"
                                    data-signal-description="@VpnProtectionRuleEditorOptions.GetSignalDescription(signal)"
                                    data-value-hint="@VpnProtectionRuleEditorOptions.GetExpectedValueHint(signal)"
                                    selected="@(Model.Signal == signal ? "selected" : null)">
                                @VpnProtectionRuleEditorOptions.GetSignalLabel(signal)
                            </option>
                        }
                    </select>
                    <small class="form-text text-muted" data-vpn-signal-hint>
                        @(Model.Signal.HasValue ? VpnProtectionRuleEditorOptions.GetSignalDescription(Model.Signal.Value) : "Select the VPN Protection value to inspect.")
                    </small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label" data-condition-label="Operator" for="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Operator">Comparison</label>
                    <select class="form-select" data-condition-field="Operator" data-role="vpn-operator" name="@(prefix).Operator" required
                            id="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Operator">
                        <option value="">Select a comparison</option>
                        @foreach (var comparison in Enum.GetValues<RuleComparisonOperator>().Where(static value => value != RuleComparisonOperator.Unknown))
                        {
                            <option value="@comparison" selected="@(Model.Operator == comparison ? "selected" : null)">
                                @VpnProtectionRuleEditorOptions.GetOperatorLabel(comparison)
                            </option>
                        }
                    </select>
                    <small class="form-text text-muted" data-vpn-operator-hint>Available comparisons depend on the signal type.</small>
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label class="form-label" data-condition-label="ExpectedValue" for="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_ExpectedValue">Expected value</label>
                    <input class="form-control" type="text" data-condition-field="ExpectedValue" data-role="vpn-expected-value" required maxlength="256"
                           name="@(prefix).ExpectedValue" id="@(prefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_ExpectedValue"
                           value="@Model.ExpectedValue" list="siege-mode-player-tags" />
                    <small class="form-text text-muted" data-vpn-expected-hint>
                        @(Model.Signal.HasValue ? VpnProtectionRuleEditorOptions.GetExpectedValueHint(Model.Signal.Value) : "Choose the value this condition should match.")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
