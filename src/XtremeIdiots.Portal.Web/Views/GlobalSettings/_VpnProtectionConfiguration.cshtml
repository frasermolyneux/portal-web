@model XtremeIdiots.Portal.Web.ViewModels.GlobalSettingsViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.RulesEngine
@using XtremeIdiots.Portal.Web.ViewModels

<div class="ibox">
    <div class="ibox-title">
        <h5><i class="fa-solid fa-fw fa-shield-halved" aria-hidden="true"></i> VPN Protection</h5>
    </div>
    <div class="ibox-content">
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="VpnProtection.Enabled" />
            <label class="form-check-label" asp-for="VpnProtection.Enabled">Enabled by default</label>
        </div>
        @await Html.PartialAsync("_RulesCatalogueEditor", new RulesCatalogueEditorViewModel
        {
            EditorId = "global-vpn-rules",
            FieldName = "VpnProtection.RulesJson",
            FeatureId = RulesEngineCatalogueV1.VpnProtectionFeature,
            RulesJson = Model.VpnProtection.RulesJson,
            TagOptions = Model.AvailableRequiredTags.Where(tag => tag.TagId != Guid.Empty)
                .Select(tag => new SelectListItem(tag.DisplayName, tag.TagId.ToString())).ToArray()
        })
    </div>
</div>
