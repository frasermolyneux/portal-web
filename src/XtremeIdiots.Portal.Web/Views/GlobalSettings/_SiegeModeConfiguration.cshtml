@model XtremeIdiots.Portal.Web.ViewModels.GlobalSettingsViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.RulesEngine
@using XtremeIdiots.Portal.Web.ViewModels

<div class="ibox">
    <div class="ibox-title">
        <h5><i class="fa-solid fa-fw fa-shield" aria-hidden="true"></i> Siege Mode</h5>
    </div>
    <div class="ibox-content">
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="SiegeMode.Enabled" />
            <label class="form-check-label" asp-for="SiegeMode.Enabled">Enabled by default</label>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="SiegeMode.DurationMinutes"></label>
            <input class="form-control" asp-for="SiegeMode.DurationMinutes" type="number" min="1" />
            <span class="text-danger" asp-validation-for="SiegeMode.DurationMinutes"></span>
        </div>
        @await Html.PartialAsync("_RulesCatalogueEditor", new RulesCatalogueEditorViewModel
        {
            EditorId = "global-siege-rules",
            FieldName = "SiegeMode.RulesJson",
            FeatureId = RulesEngineCatalogueV1.SiegeModeFeature,
            RulesJson = Model.SiegeMode.RulesJson,
            TagOptions = Model.AvailableRequiredTags.Where(tag => tag.TagId != Guid.Empty)
                .Select(tag => new SelectListItem(tag.DisplayName, tag.TagId.ToString())).ToArray()
        })
    </div>
</div>
