@model XtremeIdiots.Portal.Web.ViewModels.GlobalSettingsViewModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using XtremeIdiots.Portal.Web.ViewModels

<div class="ibox">
    <div class="ibox-title">
        <h5><i class="fa-solid fa-fw fa-shield" aria-hidden="true"></i> Siege Mode</h5>
    </div>
    <div class="ibox-content">
        <input type="hidden" asp-for="SiegeMode.SubmittedRuleCount" value="@Model.SiegeMode.Rules.Count" />
        <p class="text-muted">
            Configure the default duration and fleet-wide kick rules. Rules are evaluated independently;
            conditions inside each rule use their selected AND/OR groups. VPN conditions use the same
            signals, comparisons, and value guidance as VPN Protection.
        </p>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label" asp-for="SiegeMode.DurationMinutes"></label>
                    <input class="form-control" asp-for="SiegeMode.DurationMinutes" type="number" min="1" />
                    <span class="text-danger" asp-validation-for="SiegeMode.DurationMinutes"></span>
                    <small class="form-text text-muted">Default session duration. The published contract default is 240 minutes.</small>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Rules</h6>
            <button type="button" class="btn btn-primary btn-sm" id="add-global-siege-rule">
                <i class="fa-solid fa-fw fa-plus" aria-hidden="true"></i> Add Rule
            </button>
        </div>

        <div id="global-siege-rules">
            @for (var ruleIndex = 0; ruleIndex < Model.SiegeMode.Rules.Count; ruleIndex++)
            {
                var rule = Model.SiegeMode.Rules[ruleIndex];
                var rulePrefix = $"SiegeMode.Rules[{ruleIndex}]";
                <div class="border rounded p-3 mb-3" data-siege-rule-row>
                    <div class="row align-items-end">
                        <div class="col-lg-5">
                            <div class="mb-3">
                                <label class="form-label" data-rule-label="Id" for="@(rulePrefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Id">Rule Id</label>
                                <input class="form-control" type="text" data-rule-field="Id" name="@(rulePrefix).Id"
                                       id="@(rulePrefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Id"
                                       value="@rule.Id" required />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" data-rule-field="Enabled"
                                       name="@(rulePrefix).Enabled" id="@(rulePrefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Enabled"
                                       value="true" checked="@(rule.Enabled ? "checked" : null)" />
                                <input type="hidden" data-rule-field="Enabled-hidden" name="@(rulePrefix).Enabled" value="false" />
                                <label class="form-check-label" data-rule-label="Enabled"
                                       for="@(rulePrefix.Replace(".", "_").Replace("[", "_").Replace("]", ""))_Enabled">Enabled</label>
                            </div>
                        </div>
                        <div class="col-lg-4 text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm mb-3" data-action="remove-siege-rule">
                                <i class="fa-solid fa-fw fa-trash" aria-hidden="true"></i> Remove Rule
                            </button>
                        </div>
                    </div>

                    @{
                        var conditionViewData = new ViewDataDictionary(ViewData)
                        {
                            ["ConditionPrefix"] = $"{rulePrefix}.Condition",
                            ["AvailablePlayerTags"] = Model.AvailableRequiredTags
                        };
                    }
                    @await Html.PartialAsync("_RuleConditionEditor", rule.Condition, conditionViewData)
                </div>
            }
        </div>

        <datalist id="siege-mode-player-tags">
            @foreach (var tag in Model.AvailableRequiredTags)
            {
                <option value="@tag.Name"></option>
            }
        </datalist>
    </div>
</div>

<template id="global-siege-rule-template">
    <div class="border rounded p-3 mb-3" data-siege-rule-row>
        <div class="row align-items-end">
            <div class="col-lg-5">
                <div class="mb-3">
                    <label class="form-label" data-rule-label="Id">Rule Id</label>
                    <input class="form-control" type="text" data-rule-field="Id" required />
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" data-rule-field="Enabled" value="true" checked />
                    <input type="hidden" data-rule-field="Enabled-hidden" value="false" />
                    <label class="form-check-label" data-rule-label="Enabled">Enabled</label>
                </div>
            </div>
            <div class="col-lg-4 text-end">
                <button type="button" class="btn btn-outline-danger btn-sm mb-3" data-action="remove-siege-rule">
                    <i class="fa-solid fa-fw fa-trash" aria-hidden="true"></i> Remove Rule
                </button>
            </div>
        </div>
        <div data-siege-condition-mount></div>
    </div>
</template>

<template id="siege-mode-condition-template">
    @{
        var emptyCondition = new RuleConditionViewModel();
        var templateViewData = new ViewDataDictionary(ViewData)
        {
            ["ConditionPrefix"] = "__prefix__",
            ["AvailablePlayerTags"] = Model.AvailableRequiredTags
        };
    }
    @await Html.PartialAsync("_RuleConditionEditor", emptyCondition, templateViewData)
</template>
