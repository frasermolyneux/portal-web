@model XtremeIdiots.Portal.Web.ViewModels.GlobalSettingsViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using XtremeIdiots.Portal.Settings.Contracts.V1.Contracts.RulesEngine
@using XtremeIdiots.Portal.Web.ViewModels

@{
    var hasEffectiveTimings = WelcomeRulesSettingsMapper.TryGetEffectiveTimings(Model.WelcomeRules, null, out var effectiveTimings);
}
<div class="ibox">
    <div class="ibox-title"><h5>Welcome Messages</h5></div>
    <div class="ibox-content">
        <p class="form-text">Rules run in order. Choose whether to stop or continue after a match.</p>
        @if (!hasEffectiveTimings)
        {
            <p class="alert alert-warning">Effective timing is unavailable until rule settings are valid.</p>
        }
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="WelcomeRules.Enabled" />
            <label class="form-check-label" asp-for="WelcomeRules.Enabled">Enabled by default</label>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label" asp-for="WelcomeRules.ConnectionDelaySeconds">Default connection delay (seconds)</label>
                <input class="form-control" asp-for="WelcomeRules.ConnectionDelaySeconds" type="number" min="0" max="60" />
                <span class="text-danger" asp-validation-for="WelcomeRules.ConnectionDelaySeconds"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" asp-for="WelcomeRules.FreshnessSeconds">Freshness window (seconds)</label>
                <input class="form-control" asp-for="WelcomeRules.FreshnessSeconds" type="number" min="1" max="900" />
                <span class="text-danger" asp-validation-for="WelcomeRules.FreshnessSeconds"></span>
            </div>
        </div>
        @await Html.PartialAsync("_RulesCatalogueEditor", new RulesCatalogueEditorViewModel
        {
            EditorId = "global-welcome-rules",
            FieldName = "WelcomeRules.RulesJson",
            FeatureId = RulesEngineCatalogueV1.WelcomeMessagesFeature,
            EffectiveTimings = hasEffectiveTimings ? effectiveTimings : null,
            RulesJson = Model.WelcomeRules.RulesJson,
            TagOptions = Model.AvailableRequiredTags.Where(tag => tag.TagId != Guid.Empty)
                .Select(tag => new SelectListItem(tag.DisplayName, tag.TagId.ToString())).ToArray()
        })
    </div>
</div>
