@model XtremeIdiots.Portal.Web.ViewModels.Analytics.AnalyticsServerViewModel
@{
    ViewData["Title"] = "Server Analytics";
}

<div class="wrapper wrapper-content animated fadeInRight">
<div class="page-header mb-3">
    <h2><i class="fa-solid fa-fw fa-server" aria-hidden="true"></i> Server Analytics</h2>
    <p class="text-muted mb-0">Per-server activity, live players, events, chat and map rotation.</p>
</div>

<div class="ibox mb-2">
    <div class="ibox-content">
        <label for="af-server" class="form-label mb-1">Server</label>
        <select id="af-server" class="form-select form-select-sm" style="max-width: 480px;">
            @foreach (var server in Model.Servers)
            {
                if (Model.SelectedServerId == server.GameServerId)
                {
                    <option value="@server.GameServerId" selected>@server.GameType - @server.Title</option>
                }
                else
                {
                    <option value="@server.GameServerId">@server.GameType - @server.Title</option>
                }
            }
        </select>
    </div>
</div>

<div class="ibox">
    <div class="ibox-content">
        <div class="row g-2 align-items-end list-filters">
            <div class="col-auto">
                <label for="af-range" class="form-label mb-1">Range</label>
                <select id="af-range" class="form-select form-select-sm">
                    <option value="24h">Last 24 hours</option>
                    <option value="7d" selected>Last 7 days</option>
                    <option value="30d">Last 30 days</option>
                    <option value="90d">Last 90 days</option>
                    <option value="180d">Last 180 days</option>
                    <option value="365d">Last 365 days</option>
                </select>
            </div>
            <div class="col-auto">
                <label for="af-bucket" class="form-label mb-1">UTC bucket</label>
                <select id="af-bucket" class="form-select form-select-sm">
                    <option value="FifteenMinutes">15 minutes</option>
                    <option value="OneHour">Hourly</option>
                    <option value="OneDay" selected>Daily</option>
                </select>
            </div>
            <div class="col-auto"><button id="af-refresh" type="button" class="btn btn-primary btn-sm">Refresh</button></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="ibox">
            <div class="ibox-title"><h5><i class="fa-solid fa-fw fa-chart-line" aria-hidden="true"></i> Recorded Player Activity</h5></div>
            <div class="ibox-content">
                <p class="text-muted small">Distinct recorded players overlapping each UTC bucket, and sessions starting within it. Player-hours are recorded map-segment time, not average session length. Known bots are excluded; unclassified sessions remain. Recording is partial; missing history is not zero activity. Boundary buckets may be partial.</p>
                <div style="position: relative; height: 320px;"><canvas id="server-trend"></canvas></div>
                <pre id="server-trend-fallback" class="mt-2 analytics-fallback"></pre>
                <div id="server-trend-summary" class="mt-2 table-responsive"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ibox">
            <div class="ibox-title"><h5><i class="fa-solid fa-fw fa-signal" aria-hidden="true"></i> Live Status Snapshot</h5></div>
            <div class="ibox-content" id="server-live"></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="ibox">
            <div class="ibox-title"><h5>Events by type</h5></div>
            <div class="ibox-content" id="server-events"></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ibox">
            <div class="ibox-title"><h5>Top chatters</h5></div>
            <div class="ibox-content" id="server-chat"></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ibox">
            <div class="ibox-title"><h5>Sampled Maps</h5></div>
            <div class="ibox-content"><p class="text-muted small">Average, peak and share of recorded status samples, not map plays or elapsed time. Coverage gaps are unknown.</p></div>
            <div class="ibox-content" id="server-maps"></div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/analytics-common.js" asp-append-version="true"></script>
    <script src="~/js/analytics-server.js" asp-append-version="true"></script>
}
