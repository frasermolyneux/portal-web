@using XtremeIdiots.Portal.Repository.Abstractions.Constants.V1
@using XtremeIdiots.Portal.Repository.Abstractions.Models.V1.MapRotations
@model (MapRotationServerAssignmentDto Assignment, GameType GameType, Guid RotationId, bool Busy)
@{
    var assignment = Model.Assignment;
    var resource = (Model.GameType, assignment.GameServerId);
    var available = !Model.Busy
        && assignment.DeploymentState is not DeploymentState.Syncing and not DeploymentState.Removing and not DeploymentState.Removed
        && assignment.ActivationState is not ActivationState.Activating and not ActivationState.Deactivating;
    var hasConfig = !string.IsNullOrWhiteSpace(assignment.ConfigFilePath) && !string.IsNullOrWhiteSpace(assignment.ConfigVariableName);
}
@if (available)
{
    <div class="d-flex flex-wrap gap-2">
        @if (hasConfig)
        {
            <form policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@resource" asp-action="ApplyAssignment" method="post">
                <input type="hidden" name="assignmentId" value="@assignment.MapRotationServerAssignmentId" />
                <input type="hidden" name="mapRotationId" value="@Model.RotationId" />
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-fw fa-play" aria-hidden="true"></i> Apply rotation
                </button>
            </form>
        }
        <form policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@resource" asp-action="VerifyAssignment" method="post">
            <input type="hidden" name="assignmentId" value="@assignment.MapRotationServerAssignmentId" />
            <input type="hidden" name="mapRotationId" value="@Model.RotationId" />
            <button type="submit" class="btn btn-outline-secondary">
                <i class="fa-solid fa-fw fa-clipboard-check" aria-hidden="true"></i> Verify files
            </button>
        </form>
    </div>
}
<details class="mt-3" id="assignment-tools">
    <summary>More actions</summary>
    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (available)
        {
            <form policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@resource" asp-action="SyncAssignment" method="post">
                <input type="hidden" name="assignmentId" value="@assignment.MapRotationServerAssignmentId" />
                <input type="hidden" name="mapRotationId" value="@Model.RotationId" />
                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Repair missing or incomplete files. Configuration is unchanged.">
                    <i class="fa-solid fa-fw fa-arrows-rotate" aria-hidden="true"></i> Repair files
                </button>
            </form>
            @if (hasConfig)
            {
                <form policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@resource" asp-action="ActivateAssignment" method="post">
                    <input type="hidden" name="assignmentId" value="@assignment.MapRotationServerAssignmentId" />
                    <input type="hidden" name="mapRotationId" value="@Model.RotationId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Update only this slot's configuration. Files are unchanged.">
                        <i class="fa-solid fa-fw fa-file-pen" aria-hidden="true"></i> Reapply configuration
                    </button>
                </form>
            }
            @if (assignment.ActivationState != ActivationState.Inactive)
            {
                <form policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@resource" asp-action="DeactivateAssignment" method="post">
                    <input type="hidden" name="assignmentId" value="@assignment.MapRotationServerAssignmentId" />
                    <input type="hidden" name="mapRotationId" value="@Model.RotationId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm" data-confirm="Deactivate this slot? Its rotation configuration will be cleared. Map files are kept.">
                        <i class="fa-solid fa-fw fa-stop" aria-hidden="true"></i> Deactivate
                    </button>
                </form>
            }
            else
            {
                <form policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@resource" asp-action="DeleteAssignment" method="post">
                    <input type="hidden" name="assignmentId" value="@assignment.MapRotationServerAssignmentId" />
                    <input type="hidden" name="mapRotationId" value="@Model.RotationId" />
                    <button type="submit" class="btn btn-outline-danger btn-sm" data-confirm="Unassign this inactive slot? Map files and the rotation library are kept.">
                        <i class="fa-solid fa-fw fa-unlink" aria-hidden="true"></i> Unassign
                    </button>
                </form>
            }
            <a policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@resource" asp-action="EditAssignment" asp-route-id="@assignment.MapRotationServerAssignmentId" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-fw fa-pen-to-square" aria-hidden="true"></i> Edit settings
            </a>
        }
        <a policy="@AuthPolicies.GameServers_Maps_Read" policy-resource="@Model.GameType" asp-controller="MapManager" asp-action="Manage" asp-route-id="@assignment.GameServerId" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-fw fa-hard-drive" aria-hidden="true"></i> Manage server maps
        </a>
    </div>
</details>
