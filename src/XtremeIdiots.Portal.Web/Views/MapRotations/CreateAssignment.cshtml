@model XtremeIdiots.Portal.Web.ViewModels.CreateMapRotationAssignmentViewModel

@{
    ViewData["Title"] = "Assign Server to Map Rotation" + (ViewData["RotationTitle"] != null ? " - " +
ViewData["RotationTitle"] : "");
}

<div class="wrapper wrapper-content animated fadeInRight">
    <form asp-action="CreateAssignment" method="post">
        <input type="hidden" asp-for="@Model.MapRotationId" />

        <div class="row">
            <div class="col-12">
                <div class="container-fluid">
                    <div class="ibox">
                        <div class="ibox-title">
                            <h5>@ViewData["Title"]</h5>
                        </div>
                        <div class="ibox-content">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="mb-3">
                                <label asp-for="@Model.GameServerId" for="GameServerIdSelect" class="form-label"></label>
                                <select asp-for="@Model.GameServerId" class="form-select" id="GameServerIdSelect" data-testid="server-select">
                                    <option value="">-- Select Server --</option>
                                    @foreach (var server in Model.AvailableServers)
                                    {
                                        var fileTransportEnabled = server.FileTransportEnabled;
                                        <option value="@server.GameServerId"
                                                data-file-transport-enabled="@fileTransportEnabled.ToString().ToLowerInvariant()">
                                            @server.Title</option>
                                        }
                                    </select>
                                    <span asp-validation-for="@Model.GameServerId" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="@Model.ConfigFilePath" for="ConfigFilePathInput" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="@Model.ConfigFilePath" class="form-control" id="ConfigFilePathInput"
                                               placeholder="e.g. /mods/mymod/configs/server/mapcontrol.cfg" />
                                        @if (Model.CanBrowseServerFiles)
                                        {
                                            <button class="btn btn-outline-secondary" type="button" id="ConfigFilePathBrowseBtn"
                                                    style="display: none;" title="Browse server files"
                                                    data-file-browser-target="ConfigFilePathInput">
                                                <i class="fa-solid fa-fw fa-folder-open"></i>Browse
                                            </button>
                                        }
                                    </div>
                                    <small class="form-text text-muted">The file must contain an uncommented, quoted <code>set</code> entry for the selected variable.</small>
                                        <span asp-validation-for="@Model.ConfigFilePath" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3" id="aacp-option">
                                        <div class="form-check">
                                            <input asp-for="AacpEnabled" class="form-check-input" />
                                            <label asp-for="AacpEnabled" class="form-check-label"></label>
                                        </div>
                                        <span asp-validation-for="AacpEnabled" class="text-danger"></span>
                                        <div id="aacp-config" class="mt-2" hidden="@(!Model.AacpEnabled)">
                                            <label asp-for="AacpConfigFilePath" class="form-label"></label>
                                            <div class="input-group">
                                                <input asp-for="AacpConfigFilePath" class="form-control" required="@Model.AacpEnabled"
                                                       aria-describedby="AacpConfigFilePathHelp" />
                                                @if (Model.CanBrowseServerFiles)
                                                {
                                                    <button class="btn btn-outline-secondary" type="button" id="AacpConfigFilePathBrowseBtn"
                                                            style="display: none;" title="Browse AACP config files"
                                                            data-file-browser-target="AacpConfigFilePath">
                                                        <i class="fa-solid fa-fw fa-folder-open" aria-hidden="true"></i> Browse
                                                    </button>
                                                }
                                            </div>
                                            <span asp-validation-for="AacpConfigFilePath" class="text-danger"></span>
                                            <small class="form-text text-muted" id="AacpConfigFilePathHelp">Uses <code>scr_aacp_maps_1</code> automatically; the main rotation stays on <code>sv_maprotation</code>.</small>
                                        </div>
                                    </div>
                                    <details class="mb-3" open="@(!string.Equals(Model.ConfigVariableName, "sv_maprotation", StringComparison.OrdinalIgnoreCase) ? "open" : null)">
                                        <summary>Advanced: standalone or custom configuration slot</summary>
                                    <div class="mb-3 mt-2">
                                        <label asp-for="@Model.ConfigVariableName" for="ConfigVariableNameInput" class="form-label"></label>
                                        <input asp-for="@Model.ConfigVariableName" class="form-control"
                                               id="ConfigVariableNameInput" list="configVariableSuggestions"
                                               placeholder="e.g. sv_maprotation" />
                                        <datalist id="configVariableSuggestions">
                                            <option value="sv_maprotation" label="Standard map rotation"></option>
                                            <option value="scr_aacp_maps_1" label="AACP map list (semicolon-separated)">
                                            </option>
                                            <option value="sv_maprotation_low" label="Load-based: low player count"></option>
                                            <option value="sv_maprotation_medium" label="Load-based: medium player count">
                                            </option>
                                            <option value="sv_maprotation_high" label="Load-based: high player count"></option>
                                        </datalist>
                                        <small class="form-text text-muted">Select a suggestion or enter a custom slot.</small>
                                            <span asp-validation-for="@Model.ConfigVariableName" class="text-danger"></span>
                                        </div>
                                    </details>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="@Model.PlayerCountMin" class="form-label"></label>
                                                <input asp-for="@Model.PlayerCountMin" type="number" class="form-control" min="0"
                                                       placeholder="Optional — min players for this rotation" />
                                                <small class="form-text text-muted">For player-count-based rotation: minimum players
                                                    for this tier.</small>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label asp-for="@Model.PlayerCountMax" class="form-label"></label>
                                                    <input asp-for="@Model.PlayerCountMax" type="number" class="form-control" min="0"
                                                           placeholder="Optional — max players for this rotation" />
                                                    <small class="form-text text-muted">For player-count-based rotation: maximum players
                                                        for this tier.</small>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <button type="submit" class="btn btn-primary" data-testid="assign-server-submit">
                                                        <i class="fa-solid fa-fw fa-link" aria-hidden="true"></i> Assign Server
                                                    </button>
                                                    <a asp-action="Details" asp-route-id="@Model.MapRotationId"
                                                       class="btn btn-outline-secondary">Cancel</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    @if (Model.CanBrowseServerFiles)
                    {
                        @await Html.PartialAsync("_FileBrowserModal")
                    }

                    @section Scripts {
                        <script src="~/js/map-rotation-assignment.js" asp-append-version="true"></script>
                        @if (Model.CanBrowseServerFiles)
                        {
                            <script src="~/js/file-browse.js" asp-append-version="true"></script>
                        }
                        <script>
                            $(document).ready(function () {
                            var serverSelect = document.getElementById('GameServerIdSelect');
                            var browseButtons = document.querySelectorAll('[data-file-browser-target]');

                            if (browseButtons.length) {
                            function updateBrowseButton() {
                            var selectedOption = serverSelect.options[serverSelect.selectedIndex];
                            var fileTransportEnabled = selectedOption && selectedOption.dataset.fileTransportEnabled === 'true';
                            browseButtons.forEach(function (browseBtn) {
                            browseBtn.style.display = fileTransportEnabled ? '' : 'none';
                            });
                            }

                            serverSelect.addEventListener('change', updateBrowseButton);
                            updateBrowseButton();

                            browseButtons.forEach(function (browseBtn) {
                            browseBtn.addEventListener('click', function () {
                            var gameServerId = serverSelect.value;
                            if (gameServerId) {
                            openServerFileBrowser(gameServerId, browseBtn.dataset.fileBrowserTarget, 'map-rotation-assignment', '.cfg');
                            }
                            });
                            });
                            }
                            });
                        </script>
                    }
