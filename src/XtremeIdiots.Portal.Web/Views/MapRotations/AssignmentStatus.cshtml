@using XtremeIdiots.Portal.Repository.Abstractions.Constants.V1
@model XtremeIdiots.Portal.Web.ViewModels.AssignmentStatusViewModel

@{
    ViewData["Title"] = Model.GameServerDisplayName + " - " + Model.Group.Label;
    var pendingInstanceId = TempData["PendingInstanceId"] as string;
    var hasPending = !string.IsNullOrEmpty(pendingInstanceId);
    var hasRunningOperation = Model.Operations.Any(o => o.Status == AssignmentOperationStatus.InProgress);
    var hasPendingWithNoRow = hasPending && !Model.Operations.Any(o =>
        o.Status == AssignmentOperationStatus.InProgress && o.DurableFunctionInstanceId == pendingInstanceId);
    var busy = Model.Group.IsBusy;
    var deployResource = (Model.Rotation.GameType, Model.Assignment.GameServerId);
    var latest = Model.Operations.FirstOrDefault();
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-12">
            <div class="container-fluid">
                <div class="mb-3">
                    <a asp-action="Details" asp-route-id="@Model.Rotation.MapRotationId" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-fw fa-arrow-left" aria-hidden="true"></i> Back to rotation
                    </a>
                </div>

                <div class="ibox">
                    <div class="ibox-title">
                        <h5>@Model.GameServerDisplayName &mdash; @Model.Group.Label</h5>
                    </div>
                    <div class="ibox-content">
                        <dl class="detail-fields row mb-0">
                            <div class="detail-field col-sm-6">
                                <dt class="detail-label">Rotation</dt>
                                <dd class="detail-value">@Model.Rotation.Title</dd>
                            </div>
                            <div class="detail-field col-sm-3">
                                <dt class="detail-label">Files</dt>
                                <dd class="detail-value">
                                    @foreach (var target in Model.Group.Targets)
                                    {
                                        <div>
                                            @if (Model.Group.IsCombined) { <small>@target.SlotLabel(): </small> }
                                            @await Html.PartialAsync("_AssignmentStatusBadge", target.DeployedVersion < Model.Rotation.Version && target.DeploymentState == DeploymentState.Synced ? "UpdateNeeded" : target.DeploymentState.ToString())
                                        </div>
                                    }
                                </dd>
                            </div>
                            <div class="detail-field col-sm-3">
                                <dt class="detail-label">Configuration</dt>
                                <dd class="detail-value">
                                    @foreach (var target in Model.Group.Targets)
                                    {
                                        <div>
                                            @if (Model.Group.IsCombined) { <small>@target.SlotLabel(): </small> }
                                            @await Html.PartialAsync("_AssignmentStatusBadge", target.ActivatedVersion < Model.Rotation.Version && target.ActivationState == ActivationState.Active ? "UpdateNeeded" : target.ActivationState.ToString())
                                        </div>
                                    }
                                </dd>
                            </div>
                        </dl>

                        @foreach (var target in Model.Group.Targets.Where(a => !string.IsNullOrEmpty(a.LastError)))
                        {
                            <div class="alert alert-danger mt-3 mb-0" role="alert">
                                <strong>Action needed@(Model.Group.IsCombined ? " — " + target.SlotLabel() : "")</strong>
                                <p class="mb-0 mt-1">
                                    @if (target.DeploymentState == DeploymentState.Failed)
                                    {
                                        <text>Map files could not be prepared or verified. Review the file results before retrying.</text>
                                    }
                                    else if (target.ActivationState == ActivationState.Failed)
                                    {
                                        <text>The rotation configuration could not be updated. Check the selected file and variable in assignment settings before applying again.</text>
                                    }
                                    else
                                    {
                                        <text>The last operation needs attention. Review the technical details before retrying.</text>
                                    }
                                </p>
                                <a asp-action="EditAssignment" asp-route-id="@Model.Assignment.MapRotationServerAssignmentId"
                                   policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@deployResource"
                                   class="alert-link d-inline-block mt-2">Edit assignment settings</a>
                            </div>
                        }
                        @if (busy && !hasRunningOperation && !hasPending)
                        {
                            <div class="alert alert-warning mt-3 mb-0">
                                Status needs attention. Ask a portal administrator to investigate before retrying.
                            </div>
                        }
                        @if (Model.Group.IsAmbiguous)
                        {
                            <div class="alert alert-warning mt-3 mb-0">Multiple standard configuration targets exist. Ask a portal administrator to resolve this assignment before starting an action.</div>
                        }

                        <details class="mt-3" id="assignment-details">
                            <summary>Technical details</summary>
                            @foreach (var target in Model.Group.Targets)
                            {
                            <dl class="detail-fields row mt-3 mb-0">
                                <div class="detail-field col-sm-6">
                                    <dt class="detail-label">Config file</dt>
                                    <dd class="detail-value">@target.SlotLabel(): <code>@(target.ConfigFilePath ?? "Not set")</code></dd>
                                </div>
                                <div class="detail-field col-sm-6">
                                    <dt class="detail-label">Config variable</dt>
                                    <dd class="detail-value"><code>@(target.ConfigVariableName ?? "Not set")</code></dd>
                                </div>
                                <div class="detail-field col-sm-6">
                                    <dt class="detail-label">Created</dt>
                                    <dd class="detail-value"><time user-time utc="@target.CreatedAt"></time></dd>
                                </div>
                                <div class="detail-field col-sm-6">
                                    <dt class="detail-label">Updated</dt>
                                    <dd class="detail-value"><time user-time utc="@target.UpdatedAt"></time></dd>
                                </div>
                                @if (!string.IsNullOrEmpty(target.LastError))
                                {
                                    <div class="detail-field col-12">
                                        <dt class="detail-label">Last error</dt>
                                        <dd class="detail-value"><pre class="small text-wrap text-break mb-0">@target.LastError</pre></dd>
                                    </div>
                                }
                                @if (Model.Assignment.UnassignedAt.HasValue)
                                {
                                    <div class="detail-field col-sm-6">
                                        <dt class="detail-label">Unassigned</dt>
                                        <dd class="detail-value"><time user-time utc="@Model.Assignment.UnassignedAt.Value"></time></dd>
                                    </div>
                                }
                            </dl>
                            }
                        </details>
                    </div>
                    <div class="ibox-footer">
                        <p class="small text-muted">Apply updates files and configuration, including a matching main/map-picker slot. No server restart.</p>
                        @await Html.PartialAsync("_AssignmentActions", (Model.Assignment, Model.Rotation.GameType, Model.Rotation.MapRotationId, hasPending || hasRunningOperation || busy || Model.Group.IsAmbiguous, Model.Group.IsInactive))
                    </div>
                </div>

                <div class="ibox" id="operationsContainer"
                     data-poll-url="@Url.Action("GetSyncProgress", "MapRotations")"
                     @if (hasPending)
                     {
                         <text>data-pending-instance-id="@pendingInstanceId"</text>
                     }>
                    <div class="ibox-title"><h5>Activity</h5></div>
                    <div class="ibox-content">
                        @if (Model.Operations.Count == 0 && !hasPendingWithNoRow)
                        {
                            <p class="text-muted mb-0">No activity yet.</p>
                        }
                        else
                        {
                            <details id="operation-history" open="@(hasPending || hasRunningOperation ? "open" : null)">
                                <summary>
                                    @if (hasPending || hasRunningOperation)
                                    {
                                        <text>Current activity and recent results</text>
                                    }
                                    else if (latest != null)
                                    {
                                        var result = latest.Status switch
                                        {
                                            AssignmentOperationStatus.Succeeded => "Completed",
                                            AssignmentOperationStatus.Failed => "Failed",
                                            AssignmentOperationStatus.Cancelled => "Cancelled",
                                            _ => "In progress"
                                        };
                                        var resultClass = latest.Status switch
                                        {
                                            AssignmentOperationStatus.Succeeded => "bg-success",
                                            AssignmentOperationStatus.Failed => "bg-danger",
                                            AssignmentOperationStatus.Cancelled => "bg-secondary",
                                            _ => "bg-info"
                                        };
                                        if (latest.Status == AssignmentOperationStatus.Succeeded && Model.Group.IsCombined && Model.ActivityNeedsAttention)
                                        {
                                            result = "Needs attention";
                                            resultClass = "bg-danger";
                                        }
                                        <span>View recent actions and results</span>
                                        <span class="d-block mt-1 ms-3">
                                            Last action: @latest.ActionLabel()
                                            <span class="badge @resultClass ms-1">@result</span>
                                            <small class="text-muted ms-2">
                                                @(latest.CompletedAt.HasValue ? "Finished" : "Started")
                                                <time user-time utc="@(latest.CompletedAt ?? latest.StartedAt)"></time>
                                            </small>
                                        </span>
                                    }
                                </summary>
                                <div class="table-responsive mt-3">
                                    <table class="table table-striped table-hover table-sm" id="operationsTable">
                                        <thead>
                                            <tr>
                                                <th>Action</th>
                                                <th>Result</th>
                                                <th class="table-date-col">Started</th>
                                                <th>Duration</th>
                                                <th>Details</th>
                                                <th class="table-action-col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (hasPendingWithNoRow)
                                            {
                                                <tr class="table-info pending-bootstrap-row" data-instance-id="@pendingInstanceId">
                                                    <td>Starting</td>
                                                    <td><span class="badge bg-info">Queued</span></td>
                                                    <td colspan="2">Waiting to start...</td>
                                                    <td class="operation-error"></td>
                                                    <td></td>
                                                </tr>
                                                <tr class="progress-detail-row">
                                                    <td colspan="6" class="p-0 border-0">
                                                        <div class="px-3 py-2 bg-light">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span class="progress-label">Waiting to start...</span>
                                                                <span class="progress-percent"></span>
                                                            </div>
                                                            <div class="progress mb-2" style="height: 20px;">
                                                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" role="progressbar" style="width: 0%"></div>
                                                            </div>
                                                            <div class="progress-map-list"></div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            @foreach (var op in Model.Operations)
                                            {
                                                var isInProgress = op.Status == AssignmentOperationStatus.InProgress;
                                                <tr class="@(isInProgress ? "table-info" : "")"
                                                    @if (isInProgress && !string.IsNullOrEmpty(op.DurableFunctionInstanceId))
                                                    {
                                                        <text>data-instance-id="@op.DurableFunctionInstanceId"</text>
                                                    }>
                                                    <td>
                                                        @op.ActionLabel()
                                                        @if (Model.Group.IsCombined)
                                                        {
                                                            <small class="text-muted d-block">@Model.Group.Targets.FirstOrDefault(a => a.MapRotationServerAssignmentId == op.MapRotationServerAssignmentId)?.SlotLabel()</small>
                                                        }
                                                    </td>
                                                    <td>
                                                        @switch (op.Status)
                                                        {
                                                            case AssignmentOperationStatus.InProgress:
                                                                <span class="badge bg-info">In progress</span>
                                                                break;
                                                            case AssignmentOperationStatus.Succeeded:
                                                                <span class="badge bg-success">Completed</span>
                                                                break;
                                                            case AssignmentOperationStatus.Failed:
                                                                <span class="badge bg-danger">Failed</span>
                                                                break;
                                                            case AssignmentOperationStatus.Cancelled:
                                                                <span class="badge bg-secondary">Cancelled</span>
                                                                break;
                                                        }
                                                    </td>
                                                    <td><time user-time utc="@op.StartedAt"></time></td>
                                                    <td>
                                                        @if (op.CompletedAt.HasValue)
                                                        {
                                                            var duration = op.CompletedAt.Value - op.StartedAt;
                                                            @($"{(int)duration.TotalMinutes}m {duration.Seconds}s")
                                                        }
                                                        else if (isInProgress)
                                                        {
                                                            <span class="elapsed-timer" data-started-at="@DateTime.SpecifyKind(op.StartedAt, DateTimeKind.Utc).ToString("o")">Starting...</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="operation-error @(op.Status == AssignmentOperationStatus.Failed ? "text-danger" : "text-muted")">
                                                            @if (!string.IsNullOrEmpty(op.Error))
                                                            {
                                                                <text>This action did not complete successfully. Expand technical details for the recorded error.</text>
                                                            }
                                                        </div>
                                                        <details>
                                                            <summary>Technical details</summary>
                                                            <pre class="operation-diagnostics small text-wrap text-break mt-2 mb-1">@op.Error</pre>
                                                            @if (op.CompletedAt.HasValue)
                                                            {
                                                                <div>Completed: <time user-time utc="@op.CompletedAt.Value"></time></div>
                                                            }
                                                            <code class="small">@(op.DurableFunctionInstanceId ?? "No tracking ID")</code>
                                                        </details>
                                                    </td>
                                                    <td>
                                                        @if (isInProgress && !string.IsNullOrEmpty(op.DurableFunctionInstanceId))
                                                        {
                                                            <form policy="@AuthPolicies.MapRotations_Deploy" policy-resource="@deployResource" asp-action="CancelOperation" method="post">
                                                                <input type="hidden" name="operationId" value="@op.MapRotationAssignmentOperationId" />
                                                                <input type="hidden" name="assignmentId" value="@op.MapRotationServerAssignmentId" />
                                                                <input type="hidden" name="instanceId" value="@op.DurableFunctionInstanceId" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm" data-confirm="Request cancellation? The current step must finish safely first.">
                                                                    <i class="fa-solid fa-fw fa-ban" aria-hidden="true"></i> Cancel
                                                                </button>
                                                            </form>
                                                        }
                                                    </td>
                                                </tr>
                                                @if (isInProgress)
                                                {
                                                    <tr class="progress-detail-row">
                                                        <td colspan="6" class="p-0 border-0">
                                                            <div class="px-3 py-2 bg-light">
                                                                @if (string.IsNullOrEmpty(op.DurableFunctionInstanceId))
                                                                {
                                                                    <p class="text-muted mb-0">Live progress is unavailable. Refresh to check the recorded result.</p>
                                                                }
                                                                else
                                                                {
                                                                    <div class="d-flex justify-content-between mb-1">
                                                                        <span class="progress-label">Waiting for progress...</span>
                                                                        <span class="progress-percent"></span>
                                                                    </div>
                                                                    <div class="progress mb-2" style="height: 20px;">
                                                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" role="progressbar" style="width: 0%"></div>
                                                                    </div>
                                                                    <div class="progress-map-list"></div>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/map-rotation-progress.js" asp-append-version="true"></script>
}
