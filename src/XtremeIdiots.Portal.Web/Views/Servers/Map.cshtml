@using XtremeIdiots.Portal.Web.ViewModels
@inject IConfiguration Configuration
@model List<PublicPlayerMapPointViewModel>

@{
    ViewData["Title"] = "Player Map";
}

<div class="wrapper wrapper-content animated fadeInRight">

    <div class="row">
        <div class="col-12">

            <div class="ibox">
                <div class="ibox-title">
                    <h5>Recent player location observations across public game servers</h5>
                </div>

                <div class="ibox-content">
                    <p class="text-muted">Latest geolocated presence observations from the last 48 hours, from a capped query of up to 200 records before public-server filtering. Not live players, sessions, or a complete player count.</p>
                    @if (ViewData["MapUnavailable"] is true)
                    {
                        <p class="text-warning" role="status">Recent player observations are currently unavailable.</p>
                    }
                    else
                    {
                        <p class="text-muted">@Model.Count location observations shown.</p>
                    }
                    <div id="map" style="height: 600px; width: 100%;"></div>
                </div>
            </div>

        </div>
    </div>

</div>

@* ReSharper disable once Razor.SectionNotResolved *@

@section Scripts {
    <script>
        function initMap() {

            var map = new google.maps.Map(document.getElementById('map'),
                {
                    zoom: 2,
                    center: { lat: 0.00, lng: 0.00 }
                });

            var locations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

            var count;
            for (count = 0; count < locations.length; count++) {
                new google.maps.Marker({
                    position: new google.maps.LatLng(locations[count].Lat, locations[count].Lng),
                    map: map,
                    title: 'Recent location observation',
                    icon: {
                        url: "/images/game-icons/" + locations[count].GameType + ".png"
                    }
                });
            }
        }
    </script>

    @{
        var mapsApiKey = Configuration["Google:MapsApiKey"];
        var isValidMapsApiKey = !string.IsNullOrEmpty(mapsApiKey) && System.Text.RegularExpressions.Regex.IsMatch(mapsApiKey, @"^[A-Za-z0-9_-]+$", System.Text.RegularExpressions.RegexOptions.None, TimeSpan.FromSeconds(1));
    }
    @if (isValidMapsApiKey)
    {
        <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey&signed_in=false&callback=initMap"></script>
    }
}