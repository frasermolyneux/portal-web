@using XtremeIdiots.Portal.Repository.Abstractions.Models.V1.RulesEngine
@using XtremeIdiots.Portal.Web.ViewModels
@model RuleConditionFlowViewModel
@{
    var condition = Model.Condition;
    var evidence = Model.Evidence.FirstOrDefault(item =>
        item.Kind == RuleEvidenceNodeKind.Condition && item.ConditionPath is not null &&
        item.ConditionPath.SequenceEqual(Model.Path) &&
        (item.ConditionId is null || string.Equals(item.ConditionId, condition.ConditionId, StringComparison.Ordinal)));
}

<li class="rules-flow__condition" data-condition-path="@string.Join(".", Model.Path)">
    @if (condition.GroupOperator is not null)
    {
        <strong>@condition.GroupOperator</strong>
        @if (evidence is not null) { <partial name="_EvaluationNodeStatus" model="evidence.Status" /> }
        <ul class="rules-flow__conditions">
            @for (var index = 0; index < condition.Conditions.Length; index++)
            {
                <partial name="_FlowCondition" model="new RuleConditionFlowViewModel(condition.Conditions[index], Model.Evidence, [.. Model.Path, index])" />
            }
        </ul>
    }
    else
    {
        <strong>@(condition.DisplayName ?? condition.ConditionId ?? "Unknown condition")</strong>
        @if (condition.Operator is not null) { <span> - @condition.Operator</span> }
        @if (evidence is not null) { <partial name="_EvaluationNodeStatus" model="evidence.Status" /> }
        @foreach (var parameter in condition.SafeParameters)
        {
            <div>@parameter.Name: @parameter.Value</div>
        }
        @if (condition.HasUnavailableParameters) { <div class="text-muted">Some condition values are unavailable.</div> }
    }
    @if (!string.IsNullOrEmpty(evidence?.ReasonCode))
    {
        <div class="small text-muted">Reason: @evidence.ReasonCode</div>
    }
</li>
