@using XtremeIdiots.Portal.Repository.Abstractions.Models.V1.RulesEngine
@model RuleExecutionAuditDto
@{
    var evidence = Model.EvaluationEvidence is { HasSupportedSchema: true } supportedEvidence ? supportedEvidence : null;
    var claimedCoordinates = Model.Actions.Select(item => (item.RuleIndex, item.ActionIndex)).ToHashSet();
    var decisions = evidence?.ActionDecisions
        .Where(item => !claimedCoordinates.Contains((item.RuleIndex, item.ActionIndex))).ToArray() ?? [];
    var supersededDecisionCount = evidence is null ? 0 : evidence.ActionDecisions.Length - decisions.Length;
}

<p class="text-muted mt-2">These stages group recorded evidence; they do not establish the order of every internal step.</p>
<ol class="list-group list-group-numbered mt-2">
    <li class="list-group-item">
        <strong>Trigger and execution</strong>
        <dl class="detail-fields row mt-2">
            <div class="detail-field col-sm-6"><dt class="detail-label">Execution</dt><dd class="detail-value">@Model.ExecutionId</dd></div>
            <div class="detail-field col-sm-6"><dt class="detail-label">Connection</dt><dd class="detail-value">@Model.ConnectionId</dd></div>
            <div class="detail-field col-sm-6"><dt class="detail-label">Player GUID</dt><dd class="detail-value">@Model.PlayerGuid</dd></div>
            <div class="detail-field col-sm-6"><dt class="detail-label">Trigger</dt><dd class="detail-value">@Model.TriggerId</dd></div>
            <div class="detail-field col-sm-6"><dt class="detail-label">Updated</dt><dd class="detail-value"><time time-ago utc="@Model.UpdatedAtUtc.UtcDateTime"></time></dd></div>
            @if (Model.Coordination is { } coordination)
            {
                <div class="detail-field col-sm-6"><dt class="detail-label">Due</dt><dd class="detail-value"><time time-ago utc="@coordination.DueAtUtc.UtcDateTime"></time></dd></div>
                <div class="detail-field col-sm-6"><dt class="detail-label">Expires</dt><dd class="detail-value"><time time-ago utc="@coordination.ExpiresAtUtc.UtcDateTime"></time></dd></div>
                @if (Model.State == RuleFeatureExecutionState.Waiting && !string.IsNullOrEmpty(coordination.WaitingReason))
                {
                    <div class="detail-field col-12"><dt class="detail-label">Current waiting reason</dt><dd class="detail-value">@coordination.WaitingReason</dd></div>
                }
            }
        </dl>
    </li>
    <li class="list-group-item">
        <strong>Condition evaluation</strong>
        @if (Model.EvaluationEvidence is not null && evidence is null)
        {
            <p class="mb-0">Evaluation evidence schema version @Model.EvaluationEvidence.SchemaVersion is not supported.</p>
        }
        else if (evidence is null || evidence.Nodes.Length == 0)
        {
            <p class="mb-0">Individual condition results are not available in the recorded execution evidence.</p>
        }
        else
        {
            @foreach (var node in evidence.Nodes)
            {
                var path = node.ConditionPath is null ? null : node.ConditionPath.Length == 0
                    ? "root" : string.Join(".", node.ConditionPath.Select(index => index + 1));
                <div class="border-bottom py-2">
                    <strong>Rule @(node.RuleIndex + 1): @node.RuleId &middot; @node.Kind</strong>
                    <partial name="_EvaluationNodeStatus" model="node.Status" />
                    @if (path is not null) { <div>Condition path: @path</div> }
                    @if (node.ConditionId is not null) { <div>Condition: @node.ConditionId</div> }
                    @if (node.CheckId is not null) { <div>Check: @node.CheckId</div> }
                    @if (node.ReasonCode is not null) { <div>Reason: @node.ReasonCode</div> }
                    @if (node.Source is not null) { <div>Source: @node.Source</div> }
                    @if (node.SourceVersion is not null) { <div>Source version: @node.SourceVersion</div> }
                    <div class="small text-muted">Observed <time time-ago utc="@node.ObservedAtUtc.UtcDateTime"></time></div>
                </div>
            }
        }
        @if (evidence is { OmittedNodeCount: > 0 })
        {
            <div class="alert alert-warning mt-2">@evidence.OmittedNodeCount additional evaluation results omitted.</div>
        }
    </li>
    <li class="list-group-item">
        <strong>Recorded action decisions</strong>
        @if (Model.EvaluationEvidence is not null && evidence is null)
        {
            <p class="mb-0">Action decisions use an unsupported evidence version.</p>
        }
        else if (decisions.Length == 0 && supersededDecisionCount == 0)
        {
            <p class="mb-0">No action decisions recorded.</p>
        }
        @foreach (var decision in decisions)
        {
            <div class="border-bottom py-2">
                <strong>@decision.RuleId / @decision.ActionId</strong> (rule @(decision.RuleIndex + 1), action @(decision.ActionIndex + 1))
                <partial name="_ActionDecisionStatus" model="decision.Status" />
                @if (decision.ReasonCode is not null) { <div>Reason: @decision.ReasonCode</div> }
                <div class="small text-muted">Observed <time time-ago utc="@decision.ObservedAtUtc.UtcDateTime"></time></div>
            </div>
        }
        @if (supersededDecisionCount > 0)
        {
            <div class="text-muted">Earlier decisions were superseded by recorded action outcomes.</div>
        }
        @if (evidence is { OmittedActionDecisionCount: > 0 })
        {
            <div class="alert alert-warning mt-2">@evidence.OmittedActionDecisionCount additional action decisions omitted.</div>
        }
    </li>
    <li class="list-group-item">
        <strong>Recorded diagnostics</strong>
        @if (Model.Diagnostics.Length == 0)
        {
            <p>No typed diagnostics recorded; older executions may not provide these details.</p>
        }
        @foreach (var diagnostic in Model.Diagnostics)
        {
            <div class="@(diagnostic.Code == RuleExecutionDiagnosticCode.DiagnosticsOmitted ? "alert alert-warning" : "border-bottom py-2")">
                <strong>@diagnostic.Code</strong>
                @if (diagnostic.Code == RuleExecutionDiagnosticCode.DiagnosticsOmitted)
                {
                    <span> - @diagnostic.OmittedCount additional diagnostics omitted.</span>
                }
                <span>@diagnostic.Detail</span>
                <div class="small text-muted">
                    <time time-ago utc="@diagnostic.ObservedAtUtc.UtcDateTime"></time>
                    @if (diagnostic.RuleId is not null) { <span> Rule: @diagnostic.RuleId</span> }
                    @if (diagnostic.ActionId is not null) { <span> Action: @diagnostic.ActionId</span> }
                    @if (diagnostic.TokenKey is not null) { <span> Token: @diagnostic.TokenKey</span> }
                    @if (diagnostic.Source is not null) { <span> Source: @diagnostic.Source</span> }
                </div>
            </div>
        }
    </li>
    <li class="list-group-item">
        <strong>Prepared actions</strong>
        @if (Model.PreparedActions.Length == 0)
        {
            <p class="mb-0">No prepared actions recorded.</p>
        }
        @foreach (var prepared in Model.PreparedActions)
        {
            <div class="border-bottom py-2">
                <strong>@prepared.ActionId</strong> (rule @(prepared.RuleIndex + 1), action @(prepared.ActionIndex + 1)):
                @prepared.Outcome - @prepared.CompletedFragmentCount / @prepared.TotalFragmentCount fragments completed
                <div>@prepared.Detail</div>
            </div>
        }
    </li>
    <li class="list-group-item">
        <strong>Recorded action outcomes</strong>
        @if (Model.Actions.Length == 0)
        {
            <p class="mb-0">No action outcomes recorded.</p>
        }
        @foreach (var action in Model.Actions)
        {
            <div class="border-bottom py-2">
                <strong>@action.RuleId / @action.ActionId</strong> (rule @(action.RuleIndex + 1), action @(action.ActionIndex + 1))
                <div>@action.ActionTypeId - @action.Mode - @action.Outcome</div>
                @if (action.Outcome == RuleActionExecutionOutcome.WouldExecute || action.Mode == RuleExecutionMode.DryRun)
                {
                    <div class="text-muted">Simulated; no live application is implied.</div>
                }
                else if (action.Outcome == RuleActionExecutionOutcome.Dispatched)
                {
                    <div class="text-muted">Dispatched; application is not confirmed.</div>
                }
                else if (action.Outcome == RuleActionExecutionOutcome.OutcomeUnknown)
                {
                    <div class="text-muted">Outcome unknown; the action may have run.</div>
                }
                else if (action.Outcome == RuleActionExecutionOutcome.Applied)
                {
                    <div class="text-muted">Applied, as recorded by the execution service.</div>
                }
                @if (action.MessageIndex.HasValue && action.FragmentIndex.HasValue)
                {
                    <div>Item @(action.MessageIndex.Value + 1), fragment @(action.FragmentIndex.Value + 1)</div>
                }
                <div>@action.Detail</div>
                <div class="small text-muted">
                    Updated <time time-ago utc="@action.UpdatedAtUtc.UtcDateTime"></time>
                    @if (action.AdminActionId.HasValue) { <span> Admin action: @action.AdminActionId</span> }
                </div>
            </div>
        }
    </li>
</ol>
