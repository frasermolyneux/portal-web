@using XtremeIdiots.Portal.Repository.Abstractions.Models.V1.RulesEngine
@model RuleExecutionFlowDto
@{
    ViewData["Title"] = "Rules Execution Flow";
    var backRoute = new Dictionary<string, string>();
    foreach (var key in new[] { "serverId", "featureId", "matchStatus", "fromUtc", "toUtc", "page" })
    {
        var value = Context.Request.Query[key].ToString();
        if (!string.IsNullOrEmpty(value))
            backRoute[key] = value;
    }
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row"><div class="col-12"><div class="container-fluid">
        <div class="ibox">
            <div class="ibox-title"><h5>@ViewData["Title"]</h5></div>
            <div class="ibox-content">
                <partial name="_ExecutionFlow" model="Model" />
            </div>
            <div class="ibox-footer">
                <a class="btn btn-outline-secondary" asp-action="Index" asp-all-route-data="backRoute">Back to audit</a>
            </div>
        </div>
    </div></div></div>
</div>
